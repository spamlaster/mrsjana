{
  "name": "mrsjana",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:routing": "node scripts/routing.test.mjs",
    "test:key-house": "node scripts/key-house.test.mjs",
    "test:minimal-pairs": "node scripts/minimal-pairs.test.mjs && node scripts/minimal-pairs-session.test.mjs && node scripts/minimal-pairs-ui.test.mjs && node scripts/minimal-pairs-audio.test.mjs && node scripts/minimal-pairs-images.test.mjs",
    "voice": "node --env-file-if-exists=.env.local scripts/generate-word-audio.mjs",
    "voice:minimal-pairs": "node --env-file-if-exists=.env.local scripts/minimal-pairs-audio.mjs",
    "voice:minimal-pairs:dry-run": "node scripts/minimal-pairs-audio.mjs --dry-run",
    "images:minimal-pairs": "node scripts/minimal-pairs-images.mjs"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0"
  }
}
